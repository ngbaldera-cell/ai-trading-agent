# ============================================
# CONFIGURACIÓN PARA BINANCE TESTNET
# ============================================

# Exchange a usar: "binance" o "hyperliquid"
EXCHANGE=binance

# ============================================
# BINANCE CONFIGURATION (TESTNET)
# ============================================
# Obtén tus API keys en: https://testnet.binancefuture.com/
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here

# IMPORTANTE: Mantener en "true" para usar testnet (dinero de prueba)
# Cambiar a "false" SOLO si quieres usar dinero REAL (NO RECOMENDADO)
BINANCE_TESTNET=true

# ============================================
# TAAPI CONFIGURATION (Indicadores Técnicos)
# ============================================
# Obtén tu API key en: https://taapi.io
TAAPI_API_KEY=your_taapi_key_here

# ============================================
# OPENROUTER CONFIGURATION (LLM)
# ============================================
# Obtén tu API key en: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here
LLM_MODEL="x-ai/grok-4"

# ============================================
# TRADING CONFIGURATION
# ============================================
# Assets a tradear (separados por espacio o coma)
ASSETS="BTC ETH SOL"

# Intervalo de análisis: 1m, 5m, 15m, 1h, 4h, 1d
INTERVAL="5m"

# ============================================
# OPCIONAL: Configuración avanzada
# ============================================
# OPENROUTER_REFERER=https://your-site.com
# OPENROUTER_APP_TITLE=trading-agent
# API_HOST=0.0.0.0
# API_PORT=3000
