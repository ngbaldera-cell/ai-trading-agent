# Exchange Selection: "hyperliquid" or "binance"
EXCHANGE=binance

# TAAPI Configuration (for technical indicators)
TAAPI_API_KEY=your_taapi_key_here  # From https://taapi.io

# Hyperliquid Configuration (if using EXCHANGE=hyperliquid)
HYPERLIQUID_PRIVATE_KEY=0x_your_private_key_here  # Wallet private key
HYPERLIQUID_NETWORK=testnet  # "mainnet" or "testnet"

# Binance Configuration (if using EXCHANGE=binance)
BINANCE_API_KEY=your_binance_api_key_here  # From https://testnet.binancefuture.com
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true  # Set to "false" for real trading (NOT RECOMMENDED for testing)

# OpenRouter LLM Configuration
OPENROUTER_API_KEY=your_openrouter_key_here  # From https://openrouter.ai
LLM_MODEL="x-ai/grok-4"

# Trading Configuration
ASSETS="BTC ETH SOL BNB ZEC EIGEN"
INTERVAL="5m"

# Optional: OPENROUTER_REFERER=https://your-site.com, OPENROUTER_APP_TITLE=trading-agent